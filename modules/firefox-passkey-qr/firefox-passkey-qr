#!/usr/bin/python3 -B
"""firefox-passkey-qr module: phone-QR passkeys in Firefox, through the firefox-passkey-qr installer.

    firefox-passkey-qr check     exit 0 satisfied, 3 unsatisfied (read-only)
    firefox-passkey-qr status    the same facts, one line each (read-only)
    firefox-passkey-qr plan      the installer's own `--dry-run` listing of every step (read-only)
    firefox-passkey-qr install   as the desktop user: run the installer non-interactively

The installer (https://github.com/alex-mextner/firefox-passkey-qr, checkout ~/dev/firefox-passkey-qr) asks
before every step. This module never answers for it by typing: it passes the installer's own `--yes`.
Whether the Bluetooth bridge step runs stays the installer's decision (a local or virtual adapter: skipped;
no adapter and a reachable Home Assistant: ha-ble-vhci is installed). Home Assistant's long-lived token
comes from the Secret Service (`purpose ha-token`) into the installer's environment (`HA_TOKEN`) at run
time; the installer itself keeps it in ~/.config/ha-ble-vhci/token (mode 600), outside this repository and
every profile. The installer asks for sudo itself for its root steps, so run it in a terminal.
Spec: docs/specs/ubuntu-tweak-cli.md, *Firefox*.
"""

from __future__ import annotations

import os
import re
import shutil
import sys
from collections.abc import Callable, Mapping
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from ubuntu_tweaks.module_script import (  # noqa: E402
    Finding,
    Module,
    ModuleError,
    NeedsManual,
    environment,
    invoking_account,
    keyring_secret,
    main,
    module_config,
)
from ubuntu_tweaks.process import CommandError, Process  # noqa: E402

NO_REPO = "set [modules.firefox-passkey-qr] repo to the git URL of the firefox-passkey-qr repository"
DEFAULT_CHECKOUT = "~/dev/firefox-passkey-qr"
INSTALLER = "passkey-qr"
EXIT_WAITING = 3  # `passkey-qr install`: finished what it could, something waits for a person
TOKEN_PURPOSE = "ha-token"
OPTIONS = {"checkout", "repo", "ha_url", "remove_snap"}
UPSTREAM_CHANGE = "https://github.com/alex-mextner/firefox-passkey-qr/pull/2 (`--yes`, `check`)"
REQUIRED_ROWS = (
    "Firefox (Mozilla deb)",
    "Bluetooth adapter",
    "credentialsd installed",
    "native-messaging manifest",
    "missing apt packages",
)
_ROW = re.compile(r"^\s*\[(?P<mark>[ x])\]\s+(?P<label>.+?)\s*$")


def unmet_rows(status_output: str) -> list[str]:
    """Required rows of ``passkey-qr status`` that are not ticked (for an installer without ``check``)."""
    rows = {}
    for line in status_output.splitlines():
        found = _ROW.match(line)
        if found:
            rows[found["label"]] = found["mark"] == "x"
    return [
        label
        for required in REQUIRED_ROWS
        for label, ok in rows.items()
        if label.startswith(required) and not ok
    ]


def recognised_rows(status_output: str) -> bool:
    """Every required row must appear, so a reworded installer is never read as "all fine"."""
    labels = [m["label"] for m in map(_ROW.match, status_output.splitlines()) if m]
    return all(any(label.startswith(required) for label in labels) for required in REQUIRED_ROWS)


class PasskeyQR(Module):
    name = "firefox-passkey-qr"

    def __init__(
        self,
        process: Process,
        home: Path,
        options: dict[str, object],
        *,
        is_root: bool,
        which: Callable[[str], str | None] = shutil.which,
    ) -> None:
        unknown = sorted(set(options) - OPTIONS)
        if unknown:
            raise ModuleError(f"[modules.firefox-passkey-qr] unknown option(s): {', '.join(unknown)}")
        for key in ("checkout", "repo", "ha_url"):
            if key in options and (not isinstance(options[key], str) or not options[key]):
                raise ModuleError(f"[modules.firefox-passkey-qr] {key} must be a non-empty string")
        remove_snap = options.get("remove_snap", False)
        if not isinstance(remove_snap, bool):
            raise ModuleError(f"[modules.firefox-passkey-qr] remove_snap must be true or false, got {remove_snap!r}")
        repo = options.get("repo")
        if repo is not None and not str(repo).startswith("https://"):
            raise ModuleError(f"[modules.firefox-passkey-qr] repo must be an https:// URL, got {repo!r}")
        ha_url = options.get("ha_url")
        if ha_url is not None and not str(ha_url).startswith(("http://", "https://")):
            raise ModuleError(f"[modules.firefox-passkey-qr] ha_url must be an http(s) URL, got {ha_url!r}")
        checkout = str(options.get("checkout", DEFAULT_CHECKOUT))
        if checkout.startswith("~/"):
            checkout = str(home / checkout[2:])
        if not os.path.isabs(checkout):
            raise ModuleError(f"[modules.firefox-passkey-qr] checkout must be absolute or start with ~/, got {checkout!r}")
        self._process = process
        self._is_root = is_root
        self._which = which
        self._repo = None if repo is None else str(repo)
        self._ha_url = None if ha_url is None else str(ha_url)
        self._remove_snap = remove_snap
        self._checkout = Path(checkout)
        self._installer = self._checkout / INSTALLER

    # -- the installer's interface ---------------------------------------------------------------

    def _run(self, *argv: str, timeout: float = 60) -> tuple[int, str]:
        result = self._process.query([str(self._installer), *argv], timeout=timeout, cwd=self._checkout)
        return result.returncode, (result.stdout or "").strip() or (result.stderr or "").strip()

    def _help(self) -> str:
        return self._run("--help")[1]

    def _supports(self, flag: str) -> bool:
        text = self._help()
        if flag == "check":  # a subcommand: only the `{status,check,install}` list counts, not help prose
            return re.search(r"\{[^}]*\bcheck\b[^}]*\}", text) is not None
        return re.search(rf"(?<![\w-]){re.escape(flag)}(?![\w-])", text) is not None

    def _install_argv(self) -> list[str]:
        flags = ["--yes"]
        if self._remove_snap:
            flags.append("--remove-snap")
        return [*flags, "install"]

    # -- reading ---------------------------------------------------------------------------------

    def _installer_present(self) -> bool:
        return self._installer.is_file() and os.access(self._installer, os.X_OK)

    def findings(self) -> list[Finding]:
        present = self._installer_present()
        found = [Finding(present, f"installer {self._installer}")]
        if not present:
            if self._repo is None:
                found.append(Finding(False, "repository to clone", NO_REPO, manual=True))
            return found
        if self._supports("check"):
            code, output = self._run("check")
            if code not in (0, 3):
                raise ModuleError(f"the installer's check broke (exit {code}): {output[:200]}")
            unmet = [line.strip() for line in output.splitlines() if line.strip()] if code != 0 else []
            satisfied = code == 0
        else:
            code, output = self._run("status")
            unmet = unmet_rows(output) if code == 0 else [f"status exited {code}"]
            satisfied = code == 0 and not unmet and recognised_rows(output)
            if code == 0 and not unmet and not satisfied:
                unmet = ["status output not recognised (the installer's rows changed)"]
        found.append(Finding(satisfied, "passkey-qr check (Firefox deb, Bluetooth, credentialsd, extension host, apt)", "; ".join(unmet)))
        if not satisfied and not self._supports("--yes"):
            found.append(
                Finding(
                    False,
                    "installer can run without questions (--yes)",
                    f"this checkout has none; run {self._installer} install yourself or take {UPSTREAM_CHANGE}",
                    manual=True,
                )
            )
        return found

    def plan(self) -> list[str]:
        if not self._installer_present():
            if self._repo is None:
                return [f"  needs manual: {NO_REPO}"]
            return [f"  clone {self._repo} to {self._checkout}, then:"]
        argv = ["--dry-run", *self._install_argv()] if self._supports("--yes") else ["--dry-run", "install"]
        code, output = self._run(*argv, timeout=180)
        lines = [f"  passkey-qr {' '.join(argv)}  # every step the installer would run"]
        if not self._supports("--yes"):
            lines.append("  (this checkout has no --yes: the real run needs an interactive installer)")
        if code != 0:
            return [*lines, f"  plan unavailable: the installer's dry run exited {code}"]
        return [*lines, *(f"    {line}" for line in output.splitlines())]

    # -- install (desktop user) --------------------------------------------------------------------

    def apply(self) -> None:
        if self._is_root:
            raise ModuleError("run as the desktop user, not root: the installer calls sudo for its root steps")
        if not self._installer_present():
            if self._checkout.exists() and any(self._checkout.iterdir()):
                raise ModuleError(f"{self._checkout} exists and is not a firefox-passkey-qr checkout")
            if self._repo is None:
                raise NeedsManual(NO_REPO)
            if self._which("git") is None:
                raise NeedsManual("git is not installed (the base tools step installs it)")
            self._checkout.parent.mkdir(parents=True, exist_ok=True)
            self._process.execute(["git", "clone", self._repo, str(self._checkout)])
            if not self._installer_present():
                raise ModuleError(f"{self._installer} not found after cloning {self._repo}")
        if not self._supports("--yes"):
            raise NeedsManual(
                f"run `{self._installer} install` interactively (this checkout has no --yes; "
                f"the change is on {UPSTREAM_CHANGE})"
            )
        token = keyring_secret(self._process, TOKEN_PURPOSE)
        overrides = {**({"HA_TOKEN": token} if token else {}), **({"HA_URL": self._ha_url} if self._ha_url else {})}
        with environment(**overrides):
            try:
                self._process.execute([str(self._installer), *self._install_argv()], cwd=self._checkout)
            except CommandError as error:
                if error.returncode != EXIT_WAITING:  # 3 is reserved by `passkey-qr install`; failures exit 1
                    raise
                # the installer already printed what waits for a person (a Home Assistant token, a running
                # Firefox, no Bluetooth and no Home Assistant) and every other step ran: not a failure
                raise NeedsManual(
                    f"`{INSTALLER} {' '.join(self._install_argv())}` finished what it could; the lines above "
                    "say what waits for you (then run apply again, finished steps are skipped)"
                ) from error


def build(env: Mapping[str, str]) -> PasskeyQR:
    account = invoking_account(env)
    return PasskeyQR(Process(), account.home, module_config(env), is_root=os.geteuid() == 0)


def cli(argv: list[str]) -> int:
    try:
        module = build(os.environ)
    except ModuleError as error:
        sys.stderr.write(f"firefox-passkey-qr: {error}\n")
        return 1
    return main(module, argv, out=sys.stdout, err=sys.stderr)


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))
