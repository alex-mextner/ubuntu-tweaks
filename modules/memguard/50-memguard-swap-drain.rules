// installed by ubuntu-tweaks/memguard -> /etc/polkit-1/rules.d/50-memguard-swap-drain.rules
// `memguard swap-drain` without sudo or a password: @USER@ may start and stop exactly
// swap-drain.service. Every other unit and verb falls through to the default policy.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "@USER@" &&
        action.lookup("unit") === "swap-drain.service") {
        var verb = action.lookup("verb");
        if (verb === "start" || verb === "stop") {
            return polkit.Result.YES;
        }
    }
});
