# installed by ubuntu-tweaks/memguard -> /etc/systemd/system/mem-sentinel.service
[Unit]
Description=mem-sentinel: per-omp-session memory watchdog, steers the session that is eating RAM
Documentation=https://github.com/alex-mextner/ubuntu-tweaks/blob/main/docs/specs/memguard.md
After=multi-user.target
# the sentinel's whole value is during a thrash: it must get scheduled and keep its pages
# (systemd-oomd itself was starved for 18 min on 2026-10-11, see OPEN-ISSUES.md #6)

[Service]
# notify + watchdog: the loop pings WATCHDOG=1 every tick (2 s), so systemd restarts a hung
# sentinel, not only a dead one. It also fires swap-drain.service, which has no timer.
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/usr/bin/python3 -u /usr/local/sbin/mem-sentinel
Restart=always
RestartSec=5
Nice=-10
OOMScoreAdjust=-900
MemoryMin=256M
MemoryLow=256M
LimitMEMLOCK=infinity
CPUWeight=500
IOWeight=500
# tunables: see CONFIG in /usr/local/sbin/mem-sentinel; override with a drop-in
#   systemctl edit mem-sentinel  ->  [Service] Environment=MEM_SENTINEL_GROWTH_GB=3
# swap-drain trigger: [swap] in /etc/memguard/memguard.toml
Environment=PYTHONUNBUFFERED=1
# needs root for: all cgroup.procs/memory.current, /proc/*/environ (DISPLAY), runuser -u ultra,
# systemctl start swap-drain.service
NoNewPrivileges=no
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
