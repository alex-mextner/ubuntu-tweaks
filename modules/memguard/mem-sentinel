#!/usr/bin/env python3
# installed by ubuntu-tweaks/memguard -> /usr/local/sbin/mem-sentinel (run by mem-sentinel.service)
"""mem-sentinel: per-omp-session memory watchdog that warns the *owning* agent session early.

Why this exists (OPEN-ISSUES.md #6): on 2026-10-11 13:34 three concurrent `review diff` runs plus
pytest/testcontainers/bun-test lost 26 GB in two minutes. Swap was already full, the kernel OOM
killer never fired (file-cache thrash kept "making progress"), systemd-oomd only watches one
cgroup that holds every omp session at once, and the box thrashed for 18 minutes. The agents that
caused it had been told to offload heavy work to Runpod but nobody told them *while it happened*.
This daemon attributes memory to sessions (cgroup scope omp-<N>.scope, or process tree for legacy
sessions), detects the spike while there is still headroom, and delivers a steer message into the
session that owns it (`omp-steer`), escalating to a broadcast + desktop notification when the whole
machine is about to go under. earlyoom (installed by mem-guard.sh) is the last line; this is the
first. Stdlib only, 2 s loop, designed to keep running while the box thrashes (mlockall, see unit).

Swap (memguard_swap, ubuntu-tweaks modules/memguard): while swap-drain runs, the kernel reports
SwapFree 0 % and the swapped-in pages show up as a MemAvailable fall. The sentinel reads the
drain's state file and judges (d) on the swap the device will have after the drain, and leaves
the swap-in out of the fall rate. It is also the drain's trigger (there is no timer): once the
[swap] drain conditions have held for trigger_stable_s it starts swap-drain.service. The loop
pings the systemd watchdog (WatchdogSec in the unit), so a hung sentinel is restarted too.

All knobs: MEM_SENTINEL_<NAME> env vars (see CONFIG). MEM_SENTINEL_DRY_RUN=1 logs instead of steering.
"""
import ctypes
import glob
import json
import os
import pwd
import socket
import subprocess
import sys
import syslog
import threading
import time
from collections import deque

sys.path[:0] = [os.path.dirname(os.path.realpath(__file__)), "/usr/local/lib/memguard"]
MS_IMPORT_ERROR = None
try:
    import memguard_swap as ms
except ImportError as _e:      # the watchdog must run even without the swap module
    ms = None
    MS_IMPORT_ERROR = str(_e)

GB = 1024 ** 3
PROC_SWAPS = "/proc/swaps"
PROC_PSI = "/proc/pressure/memory"


def _env(name, default, cast=float):
    v = os.environ.get("MEM_SENTINEL_" + name)
    if v is None or v == "":
        return default
    try:
        return cast(v)
    except ValueError:
        sys.stderr.write(f"mem-sentinel: bad MEM_SENTINEL_{name}={v!r}, using {default}\n")
        return default


def _desktop_user():
    """[swap] user of memguard.toml: one source with the polkit rule and the drain's heavy scan."""
    if ms is None:
        return "ultra"
    try:
        return ms.load_config()["user"]
    except (ValueError, OSError):
        return ms.DEFAULTS["user"]


def _uid_of(user):
    try:
        return pwd.getpwnam(user).pw_uid
    except KeyError:
        return 1000


_USER = _env("USER", _desktop_user(), str)

CONFIG = dict(
    INTERVAL=_env("INTERVAL", 2.0),
    DRY_RUN=bool(_env("DRY_RUN", 0, int)),
    LOG=_env("LOG", "/var/log/hang-probe/sentinel.log", str),
    USER=_USER,
    UID=_env("UID", _uid_of(_USER), int),
    SESSIONS_TTL=_env("SESSIONS_TTL", 15.0),           # omp-steer list is a tg-ctl round trip: cache it
    HEARTBEAT_S=_env("HEARTBEAT_S", 30.0),             # forensic summary line cadence (0 = off)
    # (a) low headroom + one dominant session. 25 % of 48 GB = 12 GB: at 13:35:30 we passed 12 GB
    #     free with 90 s left before the floor; the 30 % share / 8 GB floor picks the real culprit.
    LOW_AVAIL_PCT=_env("LOW_AVAIL_PCT", 25.0),
    TOP_SHARE_PCT=_env("TOP_SHARE_PCT", 30.0),
    TOP_ABS_GB=_env("TOP_ABS_GB", 8.0),
    # (b) early warning: 4 GB in 30 s is the signature of a full pytest/bun-test/mypy fan-out
    #     (the incident rate was ~13 GB/min); a single test file never does this.
    GROWTH_GB=_env("GROWTH_GB", 4.0),
    GROWTH_WINDOW_S=_env("GROWTH_WINDOW_S", 30.0),
    # (c) machine-wide fall rate; 6 GB/min means the 48 GB box has < 5 min of life left.
    FALL_GB_PER_MIN=_env("FALL_GB_PER_MIN", 6.0),
    # (d) swap was 100 % full for 13 h before the incident; below 30 % free there is no cushion.
    SWAPFREE_PCT=_env("SWAPFREE_PCT", 30.0),
    # (e) no legitimate local agent workload needs 16 GB; that is a full suite or a leak.
    SESSION_MAX_GB=_env("SESSION_MAX_GB", 16.0),
    # (f) broadcast: 10 % free (~4.8 GB) is ~1 min above earlyoom's 4 % trigger; PSI full>20 means
    #     every task already spends a fifth of its time stalled on memory = thrash has begun.
    CRIT_AVAIL_PCT=_env("CRIT_AVAIL_PCT", 10.0),
    PSI_FULL_AVG10=_env("PSI_FULL_AVG10", 20.0),
    STEER_COOLDOWN_S=_env("STEER_COOLDOWN_S", 180.0),
    BROADCAST_COOLDOWN_S=_env("BROADCAST_COOLDOWN_S", 180.0),
    RING_S=_env("RING_S", 60.0),
)

CG_ROOT = "/sys/fs/cgroup"
OMP_SLICE = f"{CG_ROOT}/user.slice/user-{CONFIG['UID']}.slice/user@{CONFIG['UID']}.service/omp.slice"
USER_HOME = f"/home/{CONFIG['USER']}"
USER_PATH = f"{USER_HOME}/.local/bin:{USER_HOME}/.bun/bin:/usr/local/bin:/usr/bin:/bin"
IS_ROOT = os.geteuid() == 0


# ----------------------------------------------------------------------------- logging
class Log:
    def __init__(self, path):
        self.path = path
        self.fh = None
        for candidate in (path, os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mem-sentinel.log")):
            try:
                os.makedirs(os.path.dirname(candidate), exist_ok=True)
                self.fh = open(candidate, "a", buffering=1)
                self.path = candidate
                break
            except OSError:
                continue
        self.echo = CONFIG["DRY_RUN"] or sys.stderr.isatty()
        syslog.openlog("mem-sentinel", syslog.LOG_PID, syslog.LOG_USER)

    def __call__(self, msg, prio=syslog.LOG_INFO):
        line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}"
        if self.fh:
            try:
                self.fh.write(line + "\n")
                os.fdatasync(self.fh.fileno())   # must survive the reset that ends a thrash
            except OSError:
                pass
        if self.echo:
            sys.stderr.write(line + "\n")
        try:
            syslog.syslog(prio, msg)
        except OSError:
            pass


# ----------------------------------------------------------------------------- readers
def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def meminfo():
    out = {}
    txt = read_file("/proc/meminfo") or ""
    for line in txt.splitlines():
        k, _, rest = line.partition(":")
        out[k] = int(rest.split()[0]) * 1024
    return out


def psi_full_avg10():
    txt = read_file(PROC_PSI) or ""
    for line in txt.splitlines():
        if line.startswith("full"):
            for tok in line.split():
                if tok.startswith("avg10="):
                    return float(tok[6:])
    return 0.0


def proc_snapshot():
    """pid -> (ppid, comm, rss_bytes) in one pass over /proc; ~1-2 ms per 100 pids."""
    page = os.sysconf("SC_PAGE_SIZE")
    procs = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        stat = read_file(f"/proc/{name}/stat")
        if not stat:
            continue
        lp, rp = stat.find("("), stat.rfind(")")
        comm = stat[lp + 1:rp]
        fields = stat[rp + 2:].split()
        try:
            procs[int(name)] = (int(fields[1]), comm, int(fields[21]) * page)
        except (IndexError, ValueError):
            continue
    return procs


def descendants(root, children):
    out, stack = [], [root]
    while stack:
        p = stack.pop()
        out.append(p)
        stack.extend(children.get(p, ()))
    return out


def cgroup_bytes(path):
    v = read_file(f"{path}/memory.current")
    return int(v) if v and v.strip().isdigit() else 0


def docker_bytes():
    limited = f"{CG_ROOT}/docker-limited.slice"
    if os.path.isdir(limited):
        return cgroup_bytes(limited)
    return sum(cgroup_bytes(p) for p in glob.glob(f"{CG_ROOT}/system.slice/docker-*.scope"))


# ----------------------------------------------------------------------------- sessions
class Sessions:
    """Live omp sessions as `tg-ctl omp-live status --json` (what omp-steer list prints) reports them."""

    def __init__(self, log):
        self.log = log
        self.by_pid = {}
        self.fetched = 0.0
        self.failed_once = False

    def as_user(self, argv):
        if IS_ROOT:
            return ["runuser", "-u", CONFIG["USER"], "--", "env", f"PATH={USER_PATH}", f"HOME={USER_HOME}"] + argv
        return argv

    def refresh(self, now):
        if now - self.fetched < CONFIG["SESSIONS_TTL"]:
            return
        self.fetched = now
        try:
            r = subprocess.run(self.as_user(["tg-ctl", "omp-live", "status", "--json"]),
                               capture_output=True, text=True, timeout=20)
            if r.returncode != 0:     # an empty stdout from a failed call must not wipe the map
                raise ValueError(f"rc={r.returncode} {r.stderr.strip()[:200]}")
            hosts = json.loads(r.stdout or "[]")
            if not isinstance(hosts, list):
                raise ValueError(f"expected a JSON list, got {type(hosts).__name__}")
            self.by_pid = {int(h["pid"]): h for h in hosts if isinstance(h, dict) and "pid" in h}
            self.failed_once = False
        except (OSError, ValueError, TypeError, subprocess.TimeoutExpired) as e:
            if not self.failed_once:   # keep the last good map; do not spam the log while tg-ctl is down
                self.log(f"sessions: omp-live status failed ({e.__class__.__name__}: {e}); keeping {len(self.by_pid)} cached",
                         syslog.LOG_WARNING)
            self.failed_once = True


# ----------------------------------------------------------------------------- swap drain
class SwapWatch:
    """swap-drain awareness and trigger (memguard_swap); inert when that module is missing."""

    def __init__(self, log, state_dir=None):
        self.trigger = None
        self.state_dir = state_dir
        if ms is None:
            log(f"swap: memguard_swap unavailable ({MS_IMPORT_ERROR}); drain awareness and trigger off",
                syslog.LOG_WARNING)
            return
        self.state_dir = state_dir or ms.STATE_DIR
        try:
            cfg = ms.load_config()
        except (ValueError, OSError) as e:
            log(f"swap: {e}; using the [swap] defaults", syslog.LOG_WARNING)
            cfg = dict(ms.DEFAULTS)
        self.trigger = ms.DrainTrigger(cfg)

    def read(self, wall):
        """(state file, the running drain or None, /proc/swaps devices)."""
        if ms is None:
            return {}, None, []
        state = ms.read_state(self.state_dir)
        return state, ms.active_drain(state, wall), ms.parse_swaps(read_file(PROC_SWAPS) or "")

    @staticmethod
    def left_bytes(drain, devices):
        """Pages of the draining device still in swap: they move into RAM as the drain runs."""
        if not drain:
            return 0
        kb = next((d.used_kb for d in devices if d.name == drain.get("device")), drain.get("left_kb", 0))
        return kb * 1024


# ----------------------------------------------------------------------------- the sentinel
class Sentinel:
    def __init__(self, state_dir=None):
        self.log = Log(CONFIG["LOG"])
        self.sessions = Sessions(self.log)
        self.swap = SwapWatch(self.log, state_dir)
        self.rings = {}            # session key -> deque[(ts, bytes)]
        self.sys_ring = deque()    # (ts, avail - pages a running drain has still to bring in)
        self.was_draining = False
        self.last_steer = {}       # key -> ts
        self.steer_count = {}      # key -> n
        self.last_broadcast = 0.0
        self.last_heartbeat = 0.0
        self.desktop_env = None
        self.mem_total = meminfo().get("MemTotal", 48 * GB)

    # -- sampling -------------------------------------------------------------------------
    def sample(self, now):
        procs = proc_snapshot()
        children = {}
        for pid, (ppid, _, _) in procs.items():
            children.setdefault(ppid, []).append(pid)
        self.sessions.refresh(now)
        omp_pids = set(self.sessions.by_pid)
        sessions = {}   # key -> dict(bytes, pids, steer_pid, label)
        claimed = set()      # omp pids owned by a scope
        scoped = set()       # every pid inside a scope: a legacy tree must not count them twice
        for scope in sorted(glob.glob(f"{OMP_SLICE}/omp-*.scope")):
            name = os.path.basename(scope)
            pids = [int(p) for p in (read_file(f"{scope}/cgroup.procs") or "").split()]
            owners = sorted(omp_pids.intersection(pids))
            claimed.update(owners)
            scoped.update(pids)
            sessions[name] = dict(bytes=cgroup_bytes(scope), pids=pids,
                                  steer_pid=owners[0] if owners else None, label=name)
        for pid in sorted(omp_pids - claimed):     # legacy: no scope, attribute by process tree
            tree = [p for p in descendants(pid, children) if p not in scoped]
            sessions[f"pid-{pid}"] = dict(bytes=sum(procs[p][2] for p in tree if p in procs), pids=tree,
                                          steer_pid=pid, label=f"legacy omp pid {pid}")
        for key, s in sessions.items():
            ring = self.rings.setdefault(key, deque())
            ring.append((now, s["bytes"]))
            while ring and now - ring[0][0] > CONFIG["RING_S"]:
                ring.popleft()
        for key in list(self.rings):
            if key not in sessions:
                del self.rings[key]
        return procs, sessions

    def growth(self, key, now, window):
        ring = self.rings.get(key)
        if not ring or len(ring) < 2:
            return 0.0
        cur = ring[-1][1]
        base = cur
        for ts, b in ring:
            if now - ts <= window:
                base = b
                break
        return cur - base

    def fall_rate(self, now):
        """MemAvailable fall in bytes/min over the last ~30 s (positive = falling)."""
        if len(self.sys_ring) < 2:
            return 0.0
        oldest = None
        for ts, a in self.sys_ring:
            if now - ts <= 30:
                oldest = (ts, a)
                break
        if not oldest or now - oldest[0] < 8:
            return 0.0
        dt = now - oldest[0]
        return (oldest[1] - self.sys_ring[-1][1]) / dt * 60

    # -- decisions ------------------------------------------------------------------------
    def tick(self):
        now, wall = time.monotonic(), time.time()
        mi = meminfo()
        total, avail = mi["MemTotal"], mi["MemAvailable"]
        swap_total, swap_free = mi.get("SwapTotal", 0), mi.get("SwapFree", 0)
        psi = psi_full_avg10()
        state, drain, devices = self.swap.read(wall)
        if drain:
            # mid-swapoff the kernel shows SwapFree 0 and SwapTotal = pages left: judge the swap
            # the device will have after the drain instead
            swap_total, swap_free = (kb * 1024 for kb in ms.effective_swap_kb(swap_total // 1024, swap_free // 1024, drain))
        if bool(drain) != self.was_draining:
            self.sys_ring.clear()      # the swap-in offset below starts/stops: old samples do not compare
            self.was_draining = bool(drain)
        # each page coming back from swap lowers avail and the drain's "left" by the same amount,
        # so avail - left moves only when something else eats (or frees) memory
        self.sys_ring.append((now, avail - self.swap.left_bytes(drain, devices)))
        while self.sys_ring and now - self.sys_ring[0][0] > CONFIG["RING_S"]:
            self.sys_ring.popleft()
        procs, sessions = self.sample(now)
        used = max(total - avail, 1)
        fall = self.fall_rate(now)
        docker = docker_bytes()
        avail_pct = avail * 100 / total
        swap_pct = swap_free * 100 / swap_total if swap_total else 100.0
        if self.swap.trigger:
            snap = ms.Snapshot(total // 1024, avail // 1024, mi.get("SwapTotal", 0) // 1024,
                               mi.get("SwapFree", 0) // 1024, ms.parse_psi(read_file(PROC_PSI) or ""), devices)
            why = self.swap.trigger.update(now, wall, snap, fall / GB, state, drain is not None)
            if why:
                self.start_drain(why)

        ranked = sorted(sessions.items(), key=lambda kv: kv[1]["bytes"], reverse=True)
        reasons = {}   # key -> [reason strings]

        def flag(key, why):
            reasons.setdefault(key, []).append(why)

        if ranked:
            top_key, top = ranked[0]
            share = top["bytes"] * 100 / used
            if avail_pct < CONFIG["LOW_AVAIL_PCT"] and (share >= CONFIG["TOP_SHARE_PCT"] or top["bytes"] >= CONFIG["TOP_ABS_GB"] * GB):
                flag(top_key, f"(a) avail {avail_pct:.0f}% < {CONFIG['LOW_AVAIL_PCT']:.0f}% and largest session holds {share:.0f}% of used")
            if swap_pct < CONFIG["SWAPFREE_PCT"]:
                flag(top_key, f"(d) SwapFree {swap_pct:.0f}% < {CONFIG['SWAPFREE_PCT']:.0f}%, largest session")
        growths = {k: self.growth(k, now, CONFIG["GROWTH_WINDOW_S"]) for k in sessions}
        for key, g in growths.items():
            if g >= CONFIG["GROWTH_GB"] * GB:
                flag(key, f"(b) grew {g / GB:.1f} GB in {CONFIG['GROWTH_WINDOW_S']:.0f} s")
        # (c) only when headroom is actually shrinking: with 30+ GB free the 30 s slope is noise
        # (seen 2026-10-12 02:25: -1.4 -> 8.5 -> 0.7 GB/min between ticks, three false steers).
        if fall >= CONFIG["FALL_GB_PER_MIN"] * GB and growths and avail_pct < 2 * CONFIG["LOW_AVAIL_PCT"]:
            fastest = max(growths, key=growths.get)
            if growths[fastest] >= GB:
                flag(fastest, f"(c) MemAvailable falling {fall / GB:.1f} GB/min, fastest-growing session")
        for key, s in sessions.items():
            if s["bytes"] >= CONFIG["SESSION_MAX_GB"] * GB:
                flag(key, f"(e) session uses {s['bytes'] / GB:.1f} GB > {CONFIG['SESSION_MAX_GB']:.0f} GB")

        for key, why in reasons.items():
            self.steer(key, sessions[key], growths[key], avail, fall, docker, procs, why, now)

        if avail_pct < CONFIG["CRIT_AVAIL_PCT"] or psi > CONFIG["PSI_FULL_AVG10"]:
            self.broadcast(avail, fall, psi, ranked, now)

        if CONFIG["HEARTBEAT_S"] and now - self.last_heartbeat >= CONFIG["HEARTBEAT_S"]:
            self.last_heartbeat = now
            tops = " ".join(f"{k}={v['bytes'] / GB:.1f}G" for k, v in ranked[:4])
            draining = (f" draining={drain.get('device')} left={self.swap.left_bytes(drain, devices) / GB:.1f}G"
                        " (swapfree after drain)" if drain else "")
            self.log(f"status avail={avail / GB:.1f}G ({avail_pct:.0f}%) swapfree={swap_free / GB:.1f}G ({swap_pct:.0f}%) "
                     f"psi_full10={psi:.1f} fall={fall / GB:.1f}G/min docker={docker / GB:.1f}G sessions={len(sessions)} "
                     f"{tops}{draining}")

    def start_drain(self, why):
        """Event trigger for swap-drain.service (it re-checks everything and logs its own decision)."""
        verb = "would-start" if CONFIG["DRY_RUN"] else "start"
        self.log(f"swap-drain {verb}: {why}")
        if not CONFIG["DRY_RUN"]:
            self.run_bg(["systemctl", "start", "--no-block", "swap-drain.service"], "swap-drain start", as_user=False)

    def top3(self, pids, procs):
        rows = sorted(((procs[p][2], procs[p][1], p) for p in pids if p in procs), reverse=True)[:3]
        return ", ".join(f"{comm} pid {pid} {rss / GB:.1f}G" for rss, comm, pid in rows), (rows[0][2] if rows else None)

    def message(self, s, growth, avail, fall, docker, procs, nth):
        top, top_pid = self.top3(s["pids"], procs)
        if docker >= 0.5 * GB:
            top = f"{top}, docker {docker / GB:.1f}G" if top else f"docker {docker / GB:.1f}G"
        prefix = "[mem-sentinel]" if nth <= 1 else f"[mem-sentinel] WARNING #{nth}, still growing -"
        kill = f"kill {top_pid}" if top_pid else "kill <pid>"
        return (f"{prefix} your session tree uses {s['bytes'] / GB:.1f} GB (top: {top or 'n/a'}), "
                f"{growth / GB:+.1f} GB in the last {CONFIG['GROWTH_WINDOW_S']:.0f} s; machine has {avail / GB:.1f} GB of "
                f"{self.mem_total / GB:.0f} free, falling {max(fall, 0) / GB:.1f} GB/min. Stop or kill the heavy process now "
                f"({kill}) and move it to Runpod (skill://runpod-offload, runpod-run -- ...); at 4 % free earlyoom kills the "
                f"largest process without asking.")

    def steer(self, key, s, growth, avail, fall, docker, procs, why, now):
        if now - self.last_steer.get(key, -1e9) < CONFIG["STEER_COOLDOWN_S"]:
            return
        self.last_steer[key] = now
        nth = self.steer_count[key] = self.steer_count.get(key, 0) + 1
        text = self.message(s, growth, avail, fall, docker, procs, nth)
        host = self.sessions.by_pid.get(s["steer_pid"]) or {}
        who = f"{s['label']} omp={s['steer_pid']} cwd={host.get('cwd', '?')} title={host.get('title', '')!r}"
        verb = "would-steer" if CONFIG["DRY_RUN"] else "steer"
        if s["steer_pid"] is None:
            verb += "(no live omp session in this scope)"
        self.log(f"{verb} #{nth} {who} reasons={'; '.join(why)} msg={text}", syslog.LOG_WARNING)
        if not CONFIG["DRY_RUN"] and s["steer_pid"] is not None:
            self.run_bg(["omp-steer", str(s["steer_pid"]), text], f"steer {key}")

    def broadcast(self, avail, fall, psi, ranked, now):
        if now - self.last_broadcast < CONFIG["BROADCAST_COOLDOWN_S"]:
            return
        self.last_broadcast = now
        tops = ", ".join(f"{self.sessions.by_pid.get(v['steer_pid'], {}).get('cwd', k)} {v['bytes'] / GB:.1f}G" for k, v in ranked[:3])
        text = (f"[mem-sentinel] MACHINE CRITICAL: {avail / GB:.1f} GB of {self.mem_total / GB:.0f} free, falling "
                f"{max(fall, 0) / GB:.1f} GB/min, memory stall {psi:.0f}%. Largest sessions: {tops or 'none attributed'}. "
                f"Every session: stop test suites, type checkers and docker builds NOW; earlyoom kills at 4 % free.")
        verb = "would-broadcast" if CONFIG["DRY_RUN"] else "broadcast"
        self.log(f"{verb} {text}", syslog.LOG_CRIT)
        if CONFIG["DRY_RUN"]:
            return
        self.run_bg(["omp-steer", "all", text], "broadcast")
        self.run_bg(["logger", "-p", "user.crit", "-t", "mem-sentinel", text], "logger", as_user=False)
        env = self.find_desktop_env()
        if env:
            self.run_bg(["notify-send", "-u", "critical", "-a", "mem-sentinel", "Memory critical", text], "notify-send", extra_env=env)

    def find_desktop_env(self):
        if self.desktop_env is not None:
            return self.desktop_env or None
        env = {}
        bus = f"/run/user/{CONFIG['UID']}/bus"
        if os.path.exists(bus):
            env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
        for name in os.listdir("/proc"):      # borrow DISPLAY/WAYLAND_DISPLAY from any desktop process of the user
            if not name.isdigit():
                continue
            try:
                if os.stat(f"/proc/{name}").st_uid != CONFIG["UID"]:
                    continue
                with open(f"/proc/{name}/environ", "rb") as f:
                    for kv in f.read().split(b"\0"):
                        if kv.startswith((b"DISPLAY=", b"WAYLAND_DISPLAY=", b"XDG_RUNTIME_DIR=")):
                            k, _, v = kv.decode(errors="replace").partition("=")
                            env.setdefault(k, v)
                if "DISPLAY" in env or "WAYLAND_DISPLAY" in env:
                    break
            except OSError:
                continue
        self.desktop_env = env if "DBUS_SESSION_BUS_ADDRESS" in env else {}
        return self.desktop_env or None

    def run_bg(self, argv, what, as_user=True, extra_env=None):
        """Delivery runs off-thread: omp-steer is a tg-ctl round trip and the loop must not stall."""
        cmd = self.sessions.as_user(argv) if as_user else argv
        if extra_env and IS_ROOT:
            cmd = cmd[:cmd.index("env") + 1] + [f"{k}={v}" for k, v in extra_env.items()] + cmd[cmd.index("env") + 1:]

        def run():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=40,
                                   env={**os.environ, **(extra_env or {})} if not IS_ROOT else None)
                out = (r.stdout.strip() or r.stderr.strip()).replace("\n", " | ")[:300]
                self.log(f"{what}: rc={r.returncode} {out}")
            except (OSError, subprocess.TimeoutExpired) as e:
                self.log(f"{what}: failed {e.__class__.__name__}: {e}", syslog.LOG_ERR)
        threading.Thread(target=run, daemon=True).start()

    # -- main loop ------------------------------------------------------------------------
    def run(self):
        lock_memory(self.log)
        trigger = self.swap.trigger.cfg if self.swap.trigger else None
        self.log(f"start uid={os.geteuid()} dry_run={CONFIG['DRY_RUN']} log={self.log.path} slice={OMP_SLICE} "
                 + " ".join(f"{k}={v}" for k, v in CONFIG.items() if k not in ("LOG", "DRY_RUN"))
                 + (f" swap_trigger={trigger['trigger']} stable_s={trigger['trigger_stable_s']}" if trigger else ""))
        notify = SdNotify()
        notify("READY=1")
        while True:
            t0 = time.monotonic()
            try:
                self.tick()
            except Exception as e:   # a sampling bug must never stop the watchdog
                self.log(f"tick error {e.__class__.__name__}: {e}", syslog.LOG_ERR)
            notify("WATCHDOG=1")     # from the loop itself: a hung tick stops the pings -> restart
            time.sleep(max(0.2, CONFIG["INTERVAL"] - (time.monotonic() - t0)))


class SdNotify:
    """sd_notify(3) over $NOTIFY_SOCKET, stdlib only; a no-op outside systemd. One socket for
    the daemon's lifetime: nothing to allocate per tick while the box thrashes."""

    def __init__(self):
        addr = os.environ.get("NOTIFY_SOCKET", "")
        self.sock = None
        if not addr:
            return
        self.addr = "\0" + addr[1:] if addr.startswith("@") else addr
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM | socket.SOCK_CLOEXEC)

    def __call__(self, msg):
        if self.sock is None:
            return
        try:
            self.sock.sendto(msg.encode(), self.addr)
        except OSError:
            pass


def lock_memory(log):
    """Pin our pages so the sentinel keeps sampling while everything else is being swapped (needs root)."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.mlockall(1 | 2) != 0:      # MCL_CURRENT | MCL_FUTURE
            log(f"mlockall unavailable (errno {ctypes.get_errno()}); continuing unpinned")
    except (OSError, AttributeError) as e:
        log(f"mlockall unavailable ({e}); continuing unpinned")


