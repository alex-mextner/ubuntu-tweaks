#!/usr/bin/python3 -B
"""passwords-app module: the iCloud Keychain password manager installed, enabled and answering on D-Bus.

    passwords-app check     exit 0 satisfied, 3 unsatisfied (read-only)
    passwords-app status    the same facts, one line each (read-only)
    passwords-app install   as the desktop user (no root): clone, install, enable, verify

It works for the desktop user (`root = false`): the checkout lives in ~/dev/passwords-app, the install is
the repository's own `scripts/install.sh` (everything under $HOME and the user's systemd), the daemon is
a user unit. What needs root (the polkit action) is the separate `passwords-app-polkit` module. The
module never reads or stores a credential: signing in to iCloud (Apple ID, password, 2FA code) is the one
step only the owner can do, reported as `manual`. Spec: docs/specs/ubuntu-tweak-cli.md, *Passwords*.
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import time
from collections.abc import Callable, Mapping
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from ubuntu_tweaks.module_script import (  # noqa: E402
    Finding,
    Module,
    ModuleError,
    NeedsManual,
    invoking_account,
    main,
    module_config,
    state_dir,
    write_file,
)
from ubuntu_tweaks.process import Process  # noqa: E402

NO_REPO = "set [modules.passwords-app] repo to the git URL of the passwords-app repository"
DEFAULT_CHECKOUT = "~/dev/passwords-app"
UNIT = "passwords-appd.service"
BUS_NAME = "io.github.alex_mextner.Passwords"
OBJECT_PATH = "/io/github/alex_mextner/Passwords"
INTERFACE = "io.github.alex_mextner.Passwords1"
HOST_NAME = "io.github.alex_mextner.passwords.json"
EXTENSION_ID = "passwords-app@alex-mextner.github.io"
SIGNED_OUT_STATES = {"signed-out", "signin-required"}
STAMP_NAME = "passwords-app.rev"
OPTIONS = {"checkout", "repo", "apple_id"}  # apple_id only prefills `passwords-app signin` (the finish step)
SIGNIN_HINT = "run `passwords-app signin` yourself (Apple ID, password and 2FA code are typed by you)"


def daemon_state(busctl_json: str) -> str | None:
    """The ``state`` field of ``GetStatus`` (``busctl --json=short``); nothing else of the reply is read."""
    try:
        state = json.loads(busctl_json)["data"][0]["state"]["data"]
    except (ValueError, KeyError, IndexError, TypeError):
        return None
    return state if isinstance(state, str) else None


class PasswordsApp(Module):
    name = "passwords-app"

    def __init__(
        self,
        process: Process,
        home: Path,
        env: Mapping[str, str],
        options: dict[str, object],
        *,
        is_root: bool,
        which: Callable[[str], str | None] = shutil.which,
        sleep: Callable[[float], None] = time.sleep,
    ) -> None:
        unknown = sorted(set(options) - OPTIONS)
        if unknown:
            raise ModuleError(f"[modules.passwords-app] unknown option(s): {', '.join(unknown)}")
        for key in OPTIONS & set(options):
            if not isinstance(options[key], str) or not options[key]:
                raise ModuleError(f"[modules.passwords-app] {key} must be a non-empty string")
        repo = options.get("repo")
        if repo is not None and not str(repo).startswith("https://"):
            raise ModuleError(f"[modules.passwords-app] repo must be an https:// URL, got {repo!r}")
        checkout = str(options.get("checkout", DEFAULT_CHECKOUT))
        if checkout.startswith("~/"):
            checkout = str(home / checkout[2:])
        if not os.path.isabs(checkout):
            raise ModuleError(f"[modules.passwords-app] checkout must be absolute or start with ~/, got {checkout!r}")
        self._process = process
        self._home = home
        self._repo = None if repo is None else str(repo)
        self._checkout = Path(checkout)
        self._is_root = is_root
        self._which = which
        self._sleep = sleep
        data_home = Path(env["XDG_DATA_HOME"]) if env.get("XDG_DATA_HOME") else home / ".local/share"
        config_home = Path(env["XDG_CONFIG_HOME"]) if env.get("XDG_CONFIG_HOME") else home / ".config"
        state_home = state_dir(home, {})  # a fixed place: the same for every service module (root ones too)
        self._app_data = data_home / "passwords-app"
        self._unit_file = config_home / "systemd/user" / UNIT
        self._stamp = state_home / STAMP_NAME

    # -- reading -----------------------------------------------------------------------------------

    def _query(self, *argv: str, timeout: float = 30) -> tuple[int, str]:
        result = self._process.query(list(argv), timeout=timeout)
        return result.returncode, (result.stdout or "").strip()

    def _head(self) -> str:
        code, out = self._query("git", "-C", str(self._checkout), "rev-parse", "HEAD")
        return out if code == 0 else ""

    def _installed_rev(self) -> str:
        try:
            return self._stamp.read_text(encoding="utf-8").strip()
        except OSError:
            return ""

    def _host_manifest_problem(self) -> str:
        """Empty when the Firefox native-messaging manifest names an existing host and our extension."""
        manifest = self._home / ".mozilla/native-messaging-hosts" / HOST_NAME
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return f"{manifest} is missing or not JSON"
        if not isinstance(data, dict):
            return f"{manifest} is not a JSON object"
        host = Path(str(data.get("path", "")))
        if not host.is_file() or not os.access(host, os.X_OK):
            return f"its host {host} is not an executable file"
        allowed = data.get("allowed_extensions")
        if not isinstance(allowed, list) or EXTENSION_ID not in allowed:
            return f"it does not allow {EXTENSION_ID}"
        return ""

    def _installed_files(self) -> bool:
        return (self._app_data / "venv/bin/passwords-appd").is_file() and (
            self._home / ".local/bin/passwords-app"
        ).is_symlink()

    def _unit_state(self, verb: str) -> str:
        lines = self._query("systemctl", "--user", verb, UNIT)[1].splitlines()
        return lines[0] if lines else ""

    def _bus_owned(self) -> bool:
        """Whether the daemon holds its bus name; unlike ``introspect`` this never activates it."""
        code, out = self._query("busctl", "--user", "list", "--acquired", "--no-legend", "--no-pager")
        return code == 0 and any(line.split(None, 1)[:1] == [BUS_NAME] for line in out.splitlines())

    def _answers(self) -> bool:
        return self._query("busctl", "--user", "introspect", BUS_NAME, OBJECT_PATH, "--no-pager")[0] == 0

    def _sync_state(self) -> str | None:
        code, out = self._query("busctl", "--user", "--json=short", "call", BUS_NAME, OBJECT_PATH, INTERFACE, "GetStatus")
        return daemon_state(out) if code == 0 else None

    def findings(self) -> list[Finding]:
        have = {tool: self._which(tool) is not None for tool in ("git", "uv")}
        found = [
            Finding(all(have.values()), "git and uv on PATH (the installer needs both)", ", ".join(t for t in have if not have[t]))
        ]
        checkout_ok = (self._checkout / "pyproject.toml").is_file()
        found.append(Finding(checkout_ok, f"checkout {self._checkout}"))
        if not checkout_ok and self._repo is None:
            found.append(Finding(False, "repository to clone", NO_REPO, manual=True))
        head = self._head() if checkout_ok else ""
        installed = self._installed_rev()
        files_ok = self._installed_files()
        found.append(
            Finding(
                files_ok and bool(head) and installed == head,
                "installed from the checkout's current commit",
                "" if files_ok else f"no install under {self._app_data}",
            )
        )
        found.append(Finding(self._unit_file.is_file(), f"user unit {self._unit_file}"))
        problem = self._host_manifest_problem()
        found.append(Finding(not problem, "Firefox native-messaging manifest", problem))
        found.append(Finding(self._unit_state("is-enabled") == "enabled", f"{UNIT} enabled"))
        found.append(Finding(self._unit_state("is-active") == "active", f"{UNIT} active"))
        owned = self._bus_owned()
        found.append(Finding(owned and self._answers(), f"{BUS_NAME} answers on the session bus"))
        state = self._sync_state() if owned else None
        if state is None:
            found.append(Finding(False, "signed in to iCloud Keychain", "daemon state unknown (it is not answering)"))
        elif state in SIGNED_OUT_STATES:
            found.append(Finding(False, "signed in to iCloud Keychain", SIGNIN_HINT, manual=True))
        else:
            found.append(Finding(True, "signed in to iCloud Keychain", f"state: {state}"))
        return found

    # -- install (desktop user) --------------------------------------------------------------------

    def apply(self) -> None:
        if self._is_root:
            raise ModuleError("run as the desktop user, not root: everything is installed under $HOME")
        if self._which("git") is None:
            raise NeedsManual("git is not installed (the base tools step installs it)")
        if self._which("uv") is None:
            raise NeedsManual("uv is not installed (the passwords-app installer needs it): brew install uv")
        if not (self._checkout / "pyproject.toml").is_file():
            if self._checkout.exists() and any(self._checkout.iterdir()):
                raise ModuleError(f"{self._checkout} exists and is not a passwords-app checkout")
            if self._repo is None:
                raise NeedsManual(NO_REPO)
            self._checkout.parent.mkdir(parents=True, exist_ok=True)
            self._process.execute(["git", "clone", self._repo, str(self._checkout)])
        head = self._head()
        if not head:
            raise ModuleError(f"{self._checkout} is not a git checkout (git rev-parse HEAD failed)")
        installer = self._checkout / "scripts/install.sh"
        if not installer.is_file():
            raise ModuleError(f"{installer} not found: not a passwords-app checkout")
        if not (self._installed_files() and self._installed_rev() == head):
            self._process.execute([str(installer)], cwd=self._checkout)
            write_file(self._stamp, head + "\n", 0o644)
        if self._unit_state("is-enabled") != "enabled":
            self._process.execute(["systemctl", "--user", "enable", UNIT])
        if self._unit_state("is-active") != "active":
            self._process.execute(["systemctl", "--user", "start", UNIT])
        for _ in range(15):  # a Type=simple unit is "started" before it owns its bus name
            if self._answers():
                break
            self._sleep(1)
        else:
            raise ModuleError(f"{UNIT} started but {BUS_NAME} does not answer: journalctl --user -u {UNIT}")
        state = self._sync_state()
        if state is None:
            raise ModuleError(f"{BUS_NAME} answers but GetStatus does not: journalctl --user -u {UNIT}")
        if state in SIGNED_OUT_STATES:
            raise NeedsManual(
                "passwords-app is running but not signed in to iCloud Keychain: run `passwords-app signin` "
                "(Apple ID, password and 2FA code are typed by you; this module never sees them)"
            )


def build(env: Mapping[str, str]) -> PasswordsApp:
    account = invoking_account(env)
    return PasswordsApp(Process(), account.home, env, module_config(env), is_root=os.geteuid() == 0)


def cli(argv: list[str]) -> int:
    try:
        module = build(os.environ)
    except ModuleError as error:
        sys.stderr.write(f"passwords-app: {error}\n")
        return 1
    return main(module, argv, out=sys.stdout, err=sys.stderr)


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))
