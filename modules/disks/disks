#!/usr/bin/python3 -B
"""disks module: the disks a profile declares are known to fstab and mount by themselves.

    disks check     exit 0 satisfied, 3 unsatisfied (read-only, no root)
    disks status    the same facts, one line each (read-only)
    disks plan      what install is going to do (read-only)
    disks install   as root: driver, mount point, /etc/fstab block, systemd units, first mount

Declared as ``[modules.disks.mounts.<name>]`` (one table per disk; a disk belongs to a machine, so it usually
lives in ``machines/<host>/machine.toml``): ``uuid`` / ``label`` / ``partuuid``, ``fstype``, and optionally
``mountpoint`` (default ``/mnt/<name>``), ``read_only``, ``driver``, ``owner``, ``automount``, ``device_timeout``,
``idle_timeout``, ``volume``, ``options``, ``description``; the keys, defaults and the filesystem table are in
``ubuntu_tweaks/disks.py``. Nothing declared means nothing planned. The module only ever adds a marked block to
``/etc/fstab`` (everything else in the file is left alone) and never unmounts, formats or repairs anything.

An unplugged disk is not drift: its entry is ``nofail`` and ``x-systemd.automount``, so the machine boots without it
and the disk mounts on first access once it is attached. Every entry is ``nosuid,nodev``. ``install`` refuses a mount
point behind a symbolic link before it changes anything, builds apfs-fuse as root in a private directory (never in
a tree a user can write) and stops the automount units of declarations that are gone. Spec:
docs/specs/ubuntu-tweak-cli.md, *Disks*.
"""

from __future__ import annotations

import enum
import os
import pwd
import re
import shutil
import stat
import sys
import tempfile
from collections.abc import Callable, Mapping
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from ubuntu_tweaks import disks as lib  # noqa: E402
from ubuntu_tweaks.errors import ConfigError  # noqa: E402
