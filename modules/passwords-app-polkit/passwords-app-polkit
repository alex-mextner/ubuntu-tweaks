#!/usr/bin/python3 -B
"""passwords-app-polkit module: the passwords-app polkit action installed where polkitd reads it.

    passwords-app-polkit check     exit 0 satisfied, 3 unsatisfied (read-only, no root)
    passwords-app-polkit status    the same facts, one line each
    passwords-app-polkit install   as root (sudo): copy the checkout's *.policy files

passwords-app's own `scripts/install.sh` cannot do this: polkit reads actions only from a root-owned
directory, so it prints a `pkexec install ...` line for the user. This module is that line, run by
`ubuntu-tweak apply --commit` through sudo and previewed first like every root action. The policy
files come from the checkout the `passwords-app` module clones (`checkout` option, same default).
Spec: docs/specs/ubuntu-tweak-cli.md, *Passwords*.
"""

from __future__ import annotations

import os
import sys
from xml.etree import ElementTree
from collections.abc import Mapping
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from ubuntu_tweaks.module_script import (  # noqa: E402
    Finding,
    Module,
    ModuleError,
    NeedsManual,
    invoking_account,
    main,
    module_config,
    read_owned_file,
    write_file,
)

DEFAULT_CHECKOUT = "~/dev/passwords-app"
ACTIONS_DIR = "usr/share/polkit-1/actions"
POLICY_DIR = "data/polkit"
ACTION_NAMESPACE = "io.github.alex_mextner.Passwords."
MAX_POLICY_BYTES = 1024 * 1024


class PasswordsAppPolkit(Module):
    name = "passwords-app-polkit"

    def __init__(self, root: Path, home: Path, uid: int, options: dict[str, object], *, is_root: bool) -> None:
        unknown = sorted(set(options) - {"checkout"})
        if unknown:
            raise ModuleError(f"[modules.passwords-app-polkit] unknown option(s): {', '.join(unknown)}")
        checkout = options.get("checkout", DEFAULT_CHECKOUT)
        if not isinstance(checkout, str) or not checkout:
            raise ModuleError("[modules.passwords-app-polkit] checkout must be a non-empty string")
        if checkout.startswith("~/"):
            checkout = str(home / checkout[2:])
        if not os.path.isabs(checkout):
            raise ModuleError(f"[modules.passwords-app-polkit] checkout must be absolute or start with ~/, got {checkout!r}")
        self._root = root
        self._uid = uid
        self._checkout = Path(checkout)
        self._is_root = is_root

    def _policies(self) -> list[Path]:
        return sorted((self._checkout / POLICY_DIR).glob("*.policy"))

    def _installed(self, policy: Path) -> Path:
        return self._root / ACTIONS_DIR / policy.name

    def _source(self, policy: Path) -> bytes:
        """The checkout is the desktop user's working copy and this script is root: read it as that user's own
        regular file and accept only actions in the app's namespace (a policy can grant pkexec rights)."""
        if not policy.name.startswith(ACTION_NAMESPACE.rstrip(".")) or not policy.name.endswith(".policy"):
            raise ModuleError(f"refusing {policy}: the file name must be {ACTION_NAMESPACE}*.policy")
        data = read_owned_file(policy, self._uid, MAX_POLICY_BYTES)
        text = data.decode("utf-8", errors="replace")
        if "<!DOCTYPE" in text or "<!ENTITY" in text:
            raise ModuleError(f"refusing {policy}: a DOCTYPE or entity could hide actions from this check")
        try:
            root = ElementTree.fromstring(data)
        except ElementTree.ParseError as error:
            raise ModuleError(f"refusing {policy}: not valid XML ({error})") from error
        ids = [action.get("id", "") for action in root.iter("action")]
        foreign = [i for i in ids if not i.startswith(ACTION_NAMESPACE)]
        if foreign or not ids:
            raise ModuleError(f"refusing {policy}: actions must be in {ACTION_NAMESPACE}*, found {foreign or 'none'}")
        for note in root.iter("annotate"):  # pkexec and `imply` reach other actions through annotations
            if note.get("key", "").startswith("org.freedesktop.policykit."):
                raise ModuleError(f"refusing {policy}: it carries a polkit annotation ({note.get('key')})")
        return data

    def _matches(self, policy: Path) -> bool:
        try:
            return self._installed(policy).read_bytes() == self._source(policy)
        except OSError:
            return False

    def findings(self) -> list[Finding]:
        policies = self._policies()
        if not policies:
            return [Finding(False, f"policy files in {self._checkout / POLICY_DIR}", "checkout missing: enable passwords-app")]
        return [Finding(self._matches(policy), f"/{ACTIONS_DIR}/{policy.name} equals the checkout's") for policy in policies]

    def apply(self) -> None:
        if not self._is_root:
            raise ModuleError("must run as root (ubuntu-tweak runs it through sudo)")
        policies = self._policies()
        if not policies:
            raise NeedsManual(f"no polkit policy under {self._checkout / POLICY_DIR}: run the passwords-app module first")
        for policy in policies:
            if not self._matches(policy):
                write_file(self._installed(policy), self._source(policy), 0o644)


def build(env: Mapping[str, str]) -> PasswordsAppPolkit:
    account = invoking_account(env)
    return PasswordsAppPolkit(Path("/"), account.home, account.uid, module_config(env), is_root=os.geteuid() == 0)


def cli(argv: list[str]) -> int:
    try:
        module = build(os.environ)
    except ModuleError as error:
        sys.stderr.write(f"passwords-app-polkit: {error}\n")
        return 1
    return main(module, argv, out=sys.stdout, err=sys.stderr)


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))
