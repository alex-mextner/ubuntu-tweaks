#!/usr/bin/python3 -B
"""firefox module: the passwords-app Firefox extension built and signed by Mozilla, staged for the policy.

    firefox check     exit 0 satisfied, 3 unsatisfied (read-only)
    firefox status    the same facts, one line each (read-only)
    firefox install   as the desktop user (no root): build, sign on AMO, stage the .xpi

Release Firefox refuses unsigned add-ons, and the passwords-app repository ships no signed build. This
module builds `extension/` (`bun run build`) and has it signed as an *unlisted* add-on with `web-ext sign`,
using the owner's AMO API credentials (JWT issuer and secret) taken from the Secret Service at run time:
`secret-tool lookup application ubuntu-tweaks purpose amo-jwt-issuer` / `amo-jwt-secret`. They go to
web-ext through its environment only: never on a command line, in a file or in the output. Without them the
install stops with `needs manual: AMO signing key` and the fact stays missing; nothing pretends to work.
The signed file is staged in ~/.local/state/ubuntu-tweaks/firefox/ for the root `firefox-policy` module.
Spec: docs/specs/ubuntu-tweak-cli.md, *Firefox*.
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import zipfile
from collections.abc import Callable, Mapping
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from ubuntu_tweaks.module_script import (  # noqa: E402
    Finding,
    Module,
    ModuleError,
    NeedsManual,
    invoking_account,
    keyring_secret,
    environment,
    main,
    module_config,
    state_dir,
    write_file,
)
from ubuntu_tweaks.process import Process  # noqa: E402

DEFAULT_CHECKOUT = "~/dev/passwords-app"
EXTENSION_ID = "passwords-app@alex-mextner.github.io"
ISSUER_PURPOSE = "amo-jwt-issuer"
SECRET_PURPOSE = "amo-jwt-secret"
API_KEY_ENV = "WEB_EXT_API_KEY"
API_SECRET_ENV = "WEB_EXT_API_SECRET"
STAGED_XPI = "passwords-app.xpi"  # one canonical file: the policy module never has to pick between builds
STAGED_VERSION = "passwords-app.version"  # the extension version that file was built from
KEY_HOWTO = (
    "AMO signing key: create an API key at https://addons.mozilla.org/developers/addon/api/key/ and store both "
    "halves in the keyring: `secret-tool store --label='AMO JWT issuer' application ubuntu-tweaks purpose "
    f"{ISSUER_PURPOSE}` and the same with `--label='AMO JWT secret'` and `purpose {SECRET_PURPOSE}` (secret-tool "
    "asks for the value; it is never written to a file)"
)


def is_signed(xpi: Path) -> bool:
    """A Mozilla-signed add-on carries a signature file under META-INF/."""
    try:
        with zipfile.ZipFile(xpi) as archive:
            return any(name.startswith("META-INF/") and name.endswith((".rsa", ".sig")) for name in archive.namelist())
    except (OSError, zipfile.BadZipFile):
        return False


class Firefox(Module):
    name = "firefox"

    def __init__(
        self,
        process: Process,
        home: Path,
        options: dict[str, object],
        *,
        is_root: bool,
        which: Callable[[str], str | None] = shutil.which,
    ) -> None:
        unknown = sorted(set(options) - {"checkout"})
        if unknown:
            raise ModuleError(f"[modules.firefox] unknown option(s): {', '.join(unknown)}")
        checkout = options.get("checkout", DEFAULT_CHECKOUT)
        if not isinstance(checkout, str) or not checkout:
            raise ModuleError("[modules.firefox] checkout must be a non-empty string")
        if checkout.startswith("~/"):
            checkout = str(home / checkout[2:])
        if not os.path.isabs(checkout):
            raise ModuleError(f"[modules.firefox] checkout must be absolute or start with ~/, got {checkout!r}")
        self._process = process
        self._is_root = is_root
        self._which = which
        self._extension = Path(checkout) / "extension"
        self._stage = state_dir(home, {}) / "firefox"  # same fixed place the root firefox-policy module reads

    def _version(self) -> str:
        try:
            version = json.loads((self._extension / "package.json").read_text(encoding="utf-8")).get("version")
        except (OSError, ValueError):
            return ""
        return version if isinstance(version, str) else ""

    def _staged_ok(self, version: str) -> bool:
        try:
            recorded = (self._stage / STAGED_VERSION).read_text(encoding="utf-8").strip()
        except OSError:
            return False
        return bool(version) and recorded == version and is_signed(self._stage / STAGED_XPI)

    def findings(self) -> list[Finding]:
        version = self._version()
        found = [
            Finding(
                bool(version),
                f"extension sources in {self._extension}",
                "" if version else "checkout missing: enable passwords-app",
            )
        ]
        found.append(
            Finding(
                self._staged_ok(version),
                f"Mozilla-signed {STAGED_XPI} of version {version or '<unknown>'} staged in {self._stage}",
            )
        )
        return found

    def apply(self) -> None:
        if self._is_root:
            raise ModuleError("run as the desktop user, not root: the signing key is in that user's keyring")
        version = self._version()
        if not version:
            raise NeedsManual(f"no extension sources at {self._extension}: enable the passwords-app module first")
        if self._staged_ok(version):
            return
        if self._which("bun") is None:
            raise NeedsManual("bun is not installed (it builds the extension): brew install bun")
        if self._which("secret-tool") is None:
            raise NeedsManual("secret-tool is not installed (libsecret-tools reads the AMO signing key)")
        issuer = keyring_secret(self._process, ISSUER_PURPOSE)
        secret = keyring_secret(self._process, SECRET_PURPOSE)
        if not issuer or not secret:
            raise NeedsManual(KEY_HOWTO)
        self._process.execute(["bun", "install", "--frozen-lockfile"], cwd=self._extension)
        self._process.execute(["bun", "run", "build"], cwd=self._extension)
        artifacts = self._stage / "web-ext-artifacts"
        artifacts.mkdir(parents=True, exist_ok=True)
        web_ext = self._extension / "node_modules/.bin/web-ext"
        with environment(**{API_KEY_ENV: issuer, API_SECRET_ENV: secret}):
            self._process.execute(
                [
                    str(web_ext),
                    "sign",
                    "--channel=unlisted",
                    f"--source-dir={self._extension / 'dist/firefox'}",
                    f"--artifacts-dir={artifacts}",
                ],
                cwd=self._extension,
            )
        signed = sorted(artifacts.glob("*.xpi"), key=lambda path: path.stat().st_mtime)
        if not signed or not is_signed(signed[-1]):
            raise ModuleError(f"web-ext sign finished but {artifacts} has no signed .xpi")
        write_file(self._stage / STAGED_XPI, signed[-1].read_bytes(), 0o644)
        write_file(self._stage / STAGED_VERSION, version + "\n", 0o644)


def build(env: Mapping[str, str]) -> Firefox:
    account = invoking_account(env)
    return Firefox(Process(), account.home, module_config(env), is_root=os.geteuid() == 0)


def cli(argv: list[str]) -> int:
    try:
        module = build(os.environ)
    except ModuleError as error:
        sys.stderr.write(f"firefox: {error}\n")
        return 1
    return main(module, argv, out=sys.stdout, err=sys.stderr)


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))
