#!/usr/bin/python3 -B
"""firefox finish step: the AMO API key that signs the passwords-app extension (spec, *Finish*).

    finish check     exit 0 once both halves of the key are in the Secret Service (read-only)
    finish prepare   opens the AMO page where the key is created (the URL is printed too)
    finish run       asks for both halves with hidden input and stores them with `secret-tool store`

The key belongs to the owner's Mozilla account, so only the owner can create it. This script never prints,
logs or writes a key to a file: each half is read with a hidden prompt, checked against the shape AMO issues
(`user:<digits>:<digits>` and 64 hex digits) and handed to `secret-tool` on its stdin. The `firefox` module's
`install` reads them back at run time and signs the extension on the next `apply`.
"""

from __future__ import annotations

import getpass
import re
import subprocess
import sys
from collections.abc import Callable, Sequence
from typing import Protocol

sys.dont_write_bytecode = True

APPLICATION = "ubuntu-tweaks"
ISSUER_PURPOSE = "amo-jwt-issuer"
SECRET_PURPOSE = "amo-jwt-secret"
KEY_PAGE = "https://addons.mozilla.org/developers/addon/api/key/"
ISSUER_SHAPE = re.compile(r"user:[0-9]+:[0-9]+")
SECRET_SHAPE = re.compile(r"[0-9a-f]{64}")
MAX_ASKS = 3


class Runner(Protocol):
    def capture(self, argv: Sequence[str], *, stdin: str | None = None) -> tuple[int, str]: ...

    def open_url(self, url: str) -> int: ...


class SystemRunner:
    def open_url(self, url: str) -> int:
        """Detached, with no pipe to wait on: a browser started by xdg-open keeps its output pipes until it exits."""
        try:
            subprocess.Popen(
                ["xdg-open", url],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            return 127
        return 0

    def capture(self, argv: Sequence[str], *, stdin: str | None = None) -> tuple[int, str]:
        try:
            done = subprocess.run(
                list(argv),
                input=stdin,
                stdin=None if stdin is not None else subprocess.DEVNULL,
                capture_output=True,
                text=True,
                errors="replace",
                timeout=30,
                check=False,
            )
        except FileNotFoundError:
            return 127, f"{argv[0]}: not found"
        except subprocess.TimeoutExpired:
            return 124, f"{argv[0]}: no answer within 30s"
        return done.returncode, (done.stdout + done.stderr).strip()


def lookup(runner: Runner, purpose: str) -> tuple[bool, str]:
    code, text = runner.capture(["secret-tool", "lookup", "application", APPLICATION, "purpose", purpose])
    if code == 127:
        return False, "secret-tool is not installed (libsecret-tools comes with the apply step)"
    return code == 0 and bool(text.strip()), ""


def check(runner: Runner) -> int:
    for purpose in (ISSUER_PURPOSE, SECRET_PURPOSE):
        found, why = lookup(runner, purpose)
        if not found:
            print(why or f"the AMO key half {purpose} is not in the keyring yet")
            return 1
    return 0


def prepare(runner: Runner) -> int:
    found, why = lookup(runner, ISSUER_PURPOSE)
    if why:
        print(why)
        return 1
    print(f"Opening {KEY_PAGE} (sign in to Mozilla there, press Generate new credentials, keep the page open)")
    code = runner.open_url(KEY_PAGE)
    if code != 0:
        print(f"Could not open a browser: open {KEY_PAGE} yourself")
    return 0


def ask(prompt: str, shape: re.Pattern[str], read: Callable[[str], str]) -> str | None:
    for _ in range(MAX_ASKS):
        value = read(prompt).strip()
        if shape.fullmatch(value):
            return value
        print("That does not look like the value AMO shows (nothing was stored); copy it again.")
    return None


def store(runner: Runner, label: str, purpose: str, value: str) -> bool:
    code, _ = runner.capture(
        ["secret-tool", "store", f"--label={label}", "application", APPLICATION, "purpose", purpose], stdin=value
    )
    return code == 0


def run(runner: Runner, read: Callable[[str], str] = getpass.getpass) -> int:
    issuer = ask("JWT issuer (looks like user:12345:67890; hidden, paste and press Enter): ", ISSUER_SHAPE, read)
    if issuer is None:
        return 1
    secret = ask("JWT secret (64 hex characters; hidden, paste and press Enter): ", SECRET_SHAPE, read)
    if secret is None:
        return 1
    if not store(runner, "AMO JWT issuer", ISSUER_PURPOSE, issuer) or not store(
        runner, "AMO JWT secret", SECRET_PURPOSE, secret
    ):
        print("secret-tool could not store the key: is the keyring unlocked?")
        return 1
    print("Stored in the keyring. The next apply signs the extension with it.")
    return 0


def main(argv: Sequence[str], runner: Runner | None = None, read: Callable[[str], str] = getpass.getpass) -> int:
    command = argv[0] if argv else ""
    shell = runner or SystemRunner()
    if command == "check":
        return check(shell)
    if command == "prepare":
        return prepare(shell)
    if command == "run":
        return run(shell, read)
    print("usage: finish check|prepare|run", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
